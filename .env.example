KOTMAN_GLOBAL_PEPPER="change_me_generate_with_openssl_rand_hex_32"
DATABASE_URL="postgres://user:password@localhost:5432/kaughtman_db?sslmode=disable"
TOKEN_ENCRYPTION_KEY="change_me_generate_with_openssl_rand_base64_32"
SHOPIFY_API_SECRET="change_me"
INTERAKT_API_KEY="change_me"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SIGNALS_MIN_MERCHANT_COUNT=50
WHATSAPP_PROVIDER=interakt
WHATSAPP_TEMPLATE_NAME=kaughtman_rto_verification
META_CAPI_ENABLED=false
MERCHANT_RATE_LIMIT_PER_MINUTE=60
# AI_MODEL_ENDPOINT=  ← set this when the trained model
#                         inference server is deployed.
#                         Leave empty to use deterministic
#                         rule-based insights (current default).

# ──────────────────────────────────────────
# SMTP — Internal team notification emails
# (early-access alerts, etc.)
# ──────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME="alerts@yourdomain.com"
SMTP_PASSWORD="change_me_use_app_password"
# Comma-separated list of internal recipient addresses
NOTIFY_TO_EMAIL="team@yourdomain.com"
